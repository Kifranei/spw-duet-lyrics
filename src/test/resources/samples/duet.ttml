<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word" xml:lang="en">
  <head>
    <metadata>
      <ttm:agent type="person" xml:id="v1"><ttm:name type="full">Alice</ttm:name></ttm:agent>
      <ttm:agent type="person" xml:id="v2"><ttm:name type="full">Bob</ttm:name></ttm:agent>
      <ttm:agent type="group" xml:id="v1000"/>
      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation type="replacement" xml:lang="zh-Hans">
            <text for="L1">你好世界</text>
            <text for="L2">我在这里<span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">（就在这里）</span></text>
          </translation>
        </translations>
      </iTunesMetadata>
    </metadata>
  </head>
  <body dur="00:20.000">
    <div begin="00:01.000" end="00:20.000">
      <p begin="00:01.000" end="00:03.500" ttm:agent="v1" itunes:key="L1"><span begin="00:01.000" end="00:01.600">Hello</span> <span begin="00:01.600" end="00:03.500">world</span></p>
      <p begin="00:04.000" end="00:07.000" ttm:agent="v2" itunes:key="L2"><span begin="00:04.000" end="00:04.500">I'm</span> <span begin="00:04.500" end="00:05.200">here</span><span ttm:role="x-bg" begin="00:05.300" end="00:07.000"><span begin="00:05.300" end="00:06.000">(right</span> <span begin="00:06.000" end="00:07.000">here)</span></span></p>
      <p begin="00:07.000" end="00:09.000" ttm:agent="v2" itunes:key="L3"><span begin="00:07.000" end="00:08.000">Same</span> <span begin="00:08.000" end="00:09.000">time</span></p>
      <p begin="00:07.000" end="00:09.000" ttm:agent="v1" itunes:key="L4"><span begin="00:07.000" end="00:09.000">Together</span><span ttm:role="x-translation" xml:lang="zh-Hans">一起</span></p>
      <p begin="00:10.000" end="00:12.000" ttm:agent="v1000" itunes:key="L5"><span begin="10s" end="11.5s">Both</span> <span begin="11500ms" end="12s">sing</span></p>
    </div>
  </body>
