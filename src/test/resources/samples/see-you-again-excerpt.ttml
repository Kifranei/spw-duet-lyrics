  <body>
    <div>
      <p begin="1:26.527" end="1:31.855" itunes:key="L19" ttm:agent="v1"><span begin="1:26.527" end="1:26.828">We've</span><span begin="1:26.828" end="1:27.018"> come</span><span begin="1:27.018" end="1:27.209"> a</span><span begin="1:27.209" end="1:28.333"> long</span><span begin="1:28.333" end="1:29.278"> way</span><span begin="1:29.817" end="1:30.118"> from</span><span begin="1:30.118" end="1:30.510"> where</span><span begin="1:30.510" end="1:30.861"> we</span><span begin="1:30.861" end="1:31.855"> began</span><span ttm:role="x-bg" begin="1:28.621" end="1:30.014"><span begin="1:28.621" end="1:29.166">(Yeah,</span><span begin="1:29.166" end="1:29.266"> we</span><span begin="1:29.266" end="1:29.366"> came</span><span begin="1:29.366" end="1:29.466"> a</span><span begin="1:29.466" end="1:29.719"> long</span><span begin="1:29.719" end="1:30.014"> way)</span><span ttm:role="x-translation" xml:lang="zh-CN">耶 走过的漫漫长路</span></span><span ttm:role="x-translation" xml:lang="zh-CN">回首我们相遇后走过的漫漫长路</span></p>
      <p begin="1:31.816" end="1:38.366" itunes:key="L20" ttm:agent="v1"><span begin="1:32.265" end="1:32.816">Oh,</span><span begin="1:32.816" end="1:33.125"> I'll</span><span begin="1:33.125" end="1:33.595"> tell</span><span begin="1:33.595" end="1:33.970"> you</span><span begin="1:33.970" end="1:34.357"> all</span><span begin="1:34.357" end="1:35.106"> about</span><span begin="1:35.106" end="1:35.445"> it</span><span begin="1:35.445" end="1:35.844"> when</span><span begin="1:35.844" end="1:36.028"> I</span><span begin="1:36.028" end="1:36.588"> see</span><span begin="1:36.588" end="1:37.105"> you</span><span begin="1:37.105" end="1:37.866"> again</span><span ttm:role="x-bg" begin="1:31.816" end="1:38.366"><span begin="1:31.816" end="1:31.916">(You</span><span begin="1:31.916" end="1:32.158"> know</span><span begin="1:32.158" end="1:32.260"> we</span><span begin="1:32.260" end="1:32.775"> started,</span><span begin="1:37.623" end="1:37.779"> let</span><span begin="1:37.779" end="1:37.911"> me</span><span begin="1:37.911" end="1:38.221"> tell</span><span begin="1:38.221" end="1:38.366"> you)</span><span ttm:role="x-translation" xml:lang="zh-CN">你知道我们已开始 让我告诉你</span></span><span ttm:role="x-translation" xml:lang="zh-CN">哦 再度重逢时 我会把一切如实相告</span></p>
      <p begin="1:38.376" end="1:40.774" itunes:key="L21" ttm:agent="v1"><span begin="1:38.376" end="1:38.748">When</span><span begin="1:38.748" end="1:38.903"> I</span><span begin="1:38.903" end="1:39.480"> see</span><span begin="1:39.480" end="1:39.884"> you</span><span begin="1:39.884" end="1:40.774"> again</span><span ttm:role="x-translation" xml:lang="zh-CN">再度重逢时</span></p>
      <p begin="3:20.360" end="3:26.277" itunes:key="L41" ttm:agent="v1"><span begin="3:20.360" end="3:23.341">Oh,</span><span begin="3:23.341" end="3:26.277"> oh</span><span ttm:role="x-bg" begin="3:22.926" end="3:25.797"><span begin="3:22.926" end="3:23.609">(Uh,</span><span begin="3:25.099" end="3:25.315"> yeah,</span><span begin="3:25.315" end="3:25.797"> yeah)</span><span ttm:role="x-translation" xml:lang="zh-CN">嗯 耶 耶</span></span><span ttm:role="x-translation" xml:lang="zh-CN">哦 哦</span></p>
      <p begin="3:26.287" end="3:32.919" itunes:key="L42" ttm:agent="v1">Woo<span ttm:role="x-bg" begin="3:28.179" end="3:29.148"><span begin="3:28.179" end="3:29.148">(Yeah</span><span ttm:role="x-translation" xml:lang="zh-CN">耶</span></span><span ttm:role="x-translation" xml:lang="zh-CN">呜</span></p>
      <p begin="3:29.243" end="3:31.790" itunes:key="L43" ttm:agent="v1"><span begin="3:29.243" end="3:29.865">When</span><span begin="3:29.865" end="3:29.965"> I</span><span begin="3:29.965" end="3:30.442"> see</span><span begin="3:30.442" end="3:30.970"> you</span><span begin="3:30.970" end="3:31.780"> again</span><span ttm:role="x-bg" begin="3:29.760" end="3:31.790"><span begin="3:29.760" end="3:30.281">(Yeah,</span><span begin="3:31.227" end="3:31.790"> uh)</span><span ttm:role="x-translation" xml:lang="zh-CN">耶 嗯</span></span><span ttm:role="x-translation" xml:lang="zh-CN">再度重逢时</span></p>
      <p begin="3:31.791" end="3:36.282" itunes:key="L44" ttm:agent="v1"><span begin="3:31.791" end="3:32.228">See</span><span begin="3:32.228" end="3:32.662"> you</span><span begin="3:32.662" end="3:36.282"> again</span><span ttm:role="x-translation" xml:lang="zh-CN">再度重逢时</span></p>
